# RevScope web app build configuration.
#
# Copy this file to .env (development) or .env.production (production builds)
# in web/app and fill in the values. Values are read at build time.

# Origin of the backend API, e.g. https://api.example.com. A value without a
# scheme gets http://, which is only right for development.
# Default: localhost:4320 (empty for the bundled self-hosted build, which calls
# the API on its own origin). In development, use localhost rather than
# 127.0.0.1 so the browser sends the session cookie.
# SERVER_HOST=
