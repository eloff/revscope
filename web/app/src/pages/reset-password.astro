---
import ResetPasswordForm from "../components/ResetPasswordForm";
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout
	title="Reset your password - RevScope"
	description="Choose a new password for your RevScope account."
>
	<main class="reset-page">
		<header class="reset-header">
			<h1 id="reset-heading">Reset your password</h1>
			<p id="reset-intro">Enter a new password to regain access to your account.</p>
		</header>
		<script is:inline>
			// Invites reuse this page: they're reset links for a user with no password yet.
			if (new URLSearchParams(location.search).has("invite")) {
				document.title = "Accept your invite - RevScope";
				document.getElementById("reset-heading").textContent = "Welcome to RevScope";
				document.getElementById("reset-intro").textContent =
					"You've been invited. Choose a password to finish setting up your account.";
			}
		</script>

		<ResetPasswordForm client:only="solid-js" />
	</main>
</AppLayout>

<style>
	.reset-page {
		max-width: 480px;
		margin: 0 auto;
		padding: 48px 24px 0;
	}

	.reset-header {
		text-align: center;
		margin-bottom: 28px;
	}

	.reset-header h1 {
		margin: 0 0 10px;
		font-size: clamp(1.7rem, 4vw, 2.3rem);
		letter-spacing: -0.02em;
	}

	.reset-header p {
		margin: 0;
		color: #4b5563;
		line-height: 1.6;
	}
</style>
