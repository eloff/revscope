---
import OAuthAuthorize from "../../components/OAuthAuthorize";
import AppLayout from "../../layouts/AppLayout.astro";
---

<AppLayout
	title="Connect an MCP client - RevScope"
	description="Approve read-only access to your RevScope account for an MCP client."
>
	<meta slot="head" name="robots" content="noindex" />

	<main class="authorize-page">
		<header class="authorize-header">
			<h1>Connect an MCP client</h1>
		</header>

		<OAuthAuthorize client:only="solid-js" />
	</main>
</AppLayout>

<style>
	.authorize-page {
		max-width: 640px;
		margin: 0 auto;
		padding: 48px 24px 64px;
	}

	.authorize-header {
		text-align: center;
		margin-bottom: 28px;
	}

	.authorize-header h1 {
		margin: 0;
		font-size: clamp(1.6rem, 4vw, 2.1rem);
		letter-spacing: -0.02em;
	}
</style>
