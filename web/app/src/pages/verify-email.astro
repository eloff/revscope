---
import VerifyEmail from "../components/VerifyEmail";
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout
	title="Confirm your email - RevScope"
	description="Confirm the email address on your RevScope account."
>
	<main class="verify-page">
		<VerifyEmail client:only="solid-js" />
	</main>
</AppLayout>

<style>
	.verify-page {
		max-width: 480px;
		margin: 0 auto;
		padding: 48px 24px 0;
	}
</style>
