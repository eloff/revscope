---
import { appPath } from "@revscope/web-shared/links";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "RevScope",
  description = "See which channels, content, and keywords convert to revenue.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href={appPath("/favicon.ico")} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
	}
</style>
