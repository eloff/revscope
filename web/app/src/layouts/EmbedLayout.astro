---
import { EMBED_REPORT_HEIGHT_EVENT } from "../lib/embedExpansion";
import { EMBED_PAGE_ATTRIBUTE } from "../lib/embedHistory";
import Layout from "./Layout.astro";

interface Props {
  title: string;
  /** Distinguishes height messages when more than one embed is on the parent page. */
  embed: string;
  /** The embed expands over the host page (see lib/embedExpansion.ts) rather than scrolling in place. */
  expandable?: boolean;
}

const { title, embed, expandable = false } = Astro.props;
---

<Layout title={title}>
	<base slot="head" target="_top" />
	<meta slot="head" name="robots" content="noindex" />
	<slot />
	<script
		define:vars={{
			embed,
			expandable,
			reportHeightEvent: EMBED_REPORT_HEIGHT_EVENT,
			embedPageAttribute: EMBED_PAGE_ATTRIBUTE,
		}}
	>
		// Inline scripts run before the deferred island modules hydrate and read it.
		document.documentElement.setAttribute(embedPageAttribute, "");
		const embedId = embed;
		// Stop the collapsed frame scrolling before the page hydrates, so the wheel
		// scrolls the host page from the start.
		if (expandable && window.parent !== window) {
			document.documentElement.style.overflow = "hidden";
		}
		// Content below a `data-embed-fold` element is cut off, so a long page
		// doesn't push the host page's own content far down; the embed can expand
		// over the host page to show the rest. The margin lets the top of what
		// follows peek out as a hint that there is more.
		const FOLD_MARGIN = 48;
		const observer = new ResizeObserver(() => report());
		let observedFold = null;
		const foldHeight = () => {
			// A view kept mounted but hidden (the demo's overview behind its full
			// dashboard) has a fold too, which must not cap the height.
			const fold =
				Array.from(document.querySelectorAll("[data-embed-fold]")).find(
					(element) => element.getClientRects().length > 0,
				) ?? null;
			if (fold !== observedFold) {
				if (observedFold) {
					observer.unobserve(observedFold);
				}
				if (fold) {
					observer.observe(fold);
				}
				observedFold = fold;
			}
			return fold ? fold.getBoundingClientRect().bottom + window.scrollY + FOLD_MARGIN : null;
		};
		const report = () => {
			const fullHeight = Math.max(
				document.documentElement.scrollHeight,
				document.body ? document.body.scrollHeight : 0,
			);
			const height = Math.min(fullHeight, foldHeight() ?? fullHeight);
			parent.postMessage(
				{ type: "revscope-embed-height", embed: embedId, height },
				"*",
			);
		};
		observer.observe(document.documentElement);
		if (document.body) {
			observer.observe(document.body);
		}
		window.addEventListener(reportHeightEvent, report);
		report();
	</script>
</Layout>

<style is:global>
	html,
	body {
		background: #ffffff;
	}
</style>
