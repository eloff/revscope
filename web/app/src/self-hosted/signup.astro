---
// Only routed in the self-hosted bundle (see astro.config.mjs). On revscope.co
// signup is the marketing site's, which also picks a plan.
import SignupForm from "../components/SignupForm";
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout title="Sign up - RevScope" description="Create your RevScope account.">
	<main class="signup-page">
		<header class="signup-header">
			<h1>Sign up</h1>
			<p>Create an account to see this instance's analytics.</p>
		</header>

		<SignupForm client:only="solid-js" />
	</main>
</AppLayout>

<style>
	.signup-page {
		max-width: 480px;
		margin: 0 auto;
		padding: 48px 24px 0;
	}

	.signup-header {
		text-align: center;
		margin-bottom: 28px;
	}

	.signup-header h1 {
		margin: 0 0 10px;
		font-size: clamp(1.7rem, 4vw, 2.3rem);
		letter-spacing: -0.02em;
	}

	.signup-header p {
		margin: 0;
		color: #4b5563;
		line-height: 1.6;
	}
</style>
