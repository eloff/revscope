# Configuration for compose.yaml. Copy this file to .env next to compose.yaml
# and fill in the values. Never commit your .env.
#
# Every variable here also reaches the revscope container, so options from
# revscope/.env.example (email, AI chat, Sentry, ...) can be added too.

# --- Required ---------------------------------------------------------------

# Encrypts integration credentials (Stripe keys, etc.). Generate with:
#   openssl rand -hex 32
# Keep it safe: credentials encrypted with a lost key can't be recovered.
INTEGRATION_ENCRYPTION_KEY=

# Password for the bundled Postgres. Generate with: openssl rand -hex 16
# (hex, since it goes into a URL). Changing it later doesn't change the
# password of an existing database.
POSTGRES_PASSWORD=

# Public URL of the UI, used in emailed links (invites, password reset).
REVSCOPE_WEB_BASE_URL=http://localhost:4320/ui

# --- HTTPS ------------------------------------------------------------------

# To serve HTTPS with the bundled Caddy, point the domain's DNS at this server,
# open ports 80 and 443, uncomment both lines, and set REVSCOPE_WEB_BASE_URL to
# https://<your domain>/ui. Caddy gets the certificate from Let's Encrypt.
# COMPOSE_PROFILES=caddy
# REVSCOPE_DOMAIN=analytics.example.com

# Using your own reverse proxy instead? Leave the lines above commented and
# proxy to 127.0.0.1:4320. It must set X-Forwarded-For.

# --- Optional ---------------------------------------------------------------

# Port on 127.0.0.1 that the backend is published on. Default: 4320
# REVSCOPE_PORT=

# MaxMind credentials (free account) to download GeoLite2-City when the image
# is built, for visitor geolocation. Without them geolocation is disabled.
# MAXMIND_ACCOUNT_ID=
# MAXMIND_LICENSE_KEY=

# Log level filter. Default: info
# RUST_LOG=
